# Copy to web/.env.local (and mirror the two Sanity values into studio/.env as
# SANITY_STUDIO_PROJECT_ID / SANITY_STUDIO_DATASET). Never commit real values.

# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sanity (web)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-26
# Server-only read token for the private dataset. Create via Sanity Manage
# (API > Tokens, "Viewer" permission) and never expose with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
